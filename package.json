{
  "private": true,
  "type": "module",
  "devDependencies": {
    "@discourse/lint-configs": "3.8.2",
    "@glint/ember-tsc": "1.11.6",
    "@playwright/test": "^1.65.1",
    "concurrently": "^9.2.3",
    "discourse": "npm:@discourse/types@2026.10.0-a5125163",
    "ember-content-mapper": "0.3.1",
    "esbuild": "0.27.0",
    "eslint": "10.6.0",
    "jsdom": "26.1.0",
    "lint-to-the-future": "^3.2.0",
    "lint-to-the-future-eslint": "^4.0.0",
    "pngjs": "7.0.0",
    "prettier": "3.8.1",
    "sass": "^1.108.2",
    "stylelint": "17.5.0",
    "three": "0.187.0",
    "typescript": "7.1.0-dev.20260930.4"
  },
  "scripts": {
    "build:viewer": "node scripts/build-renderer.mjs",
    "test": "node --test test/node/*.test.mjs",
    "test:browser": "playwright test",
    "test:preview": "node scripts/test-server.mjs",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\"",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\"",
    "lint:css": "pnpm stylelint '{javascripts,desktop,mobile,common,scss,stylesheets}/**/*.scss' --allow-empty-input",
    "lint:css:fix": "pnpm stylelint '{javascripts,desktop,mobile,common,scss,stylesheets}/**/*.scss' --fix --allow-empty-input",
    "lint:js": "eslint javascripts renderer scripts test --cache --no-error-on-unmatched-pattern",
    "lint:js:fix": "eslint javascripts renderer scripts test --fix --no-error-on-unmatched-pattern",
    "lint:prettier": "pnpm prettier '{javascripts,desktop,mobile,common,scss,stylesheets}/**/*.scss' '{javascripts,renderer,scripts,test}/**/*.{js,gjs,mjs,ts,gts,mts,cts}' --check --no-error-on-unmatched-pattern",
    "lint:prettier:fix": "pnpm prettier '{javascripts,desktop,mobile,common,scss,stylesheets}/**/*.scss' '{javascripts,renderer,scripts,test}/**/*.{js,gjs,mjs,ts,gts,mts,cts}' --write --no-error-on-unmatched-pattern",
    "lint:types": "tsc -b --runExternalCode",
    "lttf:ignore": "lint-to-the-future ignore",
    "update-skeleton": "pnpx @discourse/update-skeleton@latest"
  },
  "engines": {
    "node": ">= 22",
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm",
    "pnpm": "^12"
  },
  "packageManager": "pnpm@12.11.2"
}
